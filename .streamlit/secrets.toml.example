# Streamlit Secrets 템플릿
# 실제 사용 시 이 파일을 secrets.toml로 복사하고 값 입력
# secrets.toml은 .gitignore에 포함되어 있음

# 앱 비밀번호 (단일 비번)
APP_PASSWORD = "여기에_원하는_비번_입력"

# 페이스북 마케팅 API
[facebook]
ACCESS_TOKEN = "EAAxxx..."
AD_ACCOUNT_ID = "act_1234567890"
APP_ID = "123456789"
APP_SECRET = "abc123..."

# 네이버 커머스 API
[naver]
CLIENT_ID = "xxx"
CLIENT_SECRET = "xxx"
ACCOUNT_ID = "xxx"

# 네이버 검색광고 OpenAPI
# 발급: 네이버 검색광고센터 → 도구 → API 사용 관리 → 신규 라이선스 등록
# 인증: HMAC-SHA256 시그니처 (X-Timestamp + X-API-KEY + X-Customer + X-Signature)
[naver_searchad]
API_KEY = "0100000000xxx..."   # 액세스 라이선스 (16진수)
SECRET_KEY = "xxx..."          # 비밀키 (base64)
CUSTOMER_ID = "1234567"        # 광고주 고객 ID (숫자)

# 네이버 GFA(성과형) 광고 API
# 발급: 네이버 비즈니스 광고센터 → API 액세스 신청
# 인증: HMAC-SHA256 시그니처 (X-Timestamp + X-API-KEY + X-Customer + X-Signature)
[naver_gfa]
ACCESS_KEY = "xxx"        # API 라이선스 키 (액세스 키)
SECRET_KEY = "xxx"        # API 시크릿 키
CUSTOMER_ID = "xxx"       # 광고주 고객 ID

# 구글 Service Account
[google]
SHEET_ID = "1AbCdEfG..."
# JSON 파일 내용 통째로 (개행 포함)
SERVICE_ACCOUNT_JSON = """
{
  "type": "service_account",
  "project_id": "...",
  "private_key_id": "...",
  "private_key": "-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n",
  "client_email": "sheets-writer@xxx.iam.gserviceaccount.com",
  "client_id": "...",
  "auth_uri": "https://accounts.google.com/o/oauth2/auth",
  "token_uri": "https://oauth2.googleapis.com/token"
}
"""
