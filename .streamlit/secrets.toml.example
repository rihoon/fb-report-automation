# Streamlit Secrets 템플릿
# 실제 사용 시 이 파일을 secrets.toml로 복사하고 값 입력
# secrets.toml은 .gitignore에 포함되어 있음

# 앱 비밀번호 (단일 비번)
APP_PASSWORD = "여기에_원하는_비번_입력"

# 페이스북 마케팅 API
[facebook]
ACCESS_TOKEN = "EAAxxx..."
AD_ACCOUNT_ID = "act_1234567890"
APP_ID = "123456789"
APP_SECRET = "abc123..."

# 네이버 커머스 API
[naver]
CLIENT_ID = "xxx"
CLIENT_SECRET = "xxx"
ACCOUNT_ID = "xxx"

# 구글 Service Account
[google]
SHEET_ID = "1AbCdEfG..."
# JSON 파일 내용 통째로 (개행 포함)
SERVICE_ACCOUNT_JSON = """
{
  "type": "service_account",
  "project_id": "...",
  "private_key_id": "...",
  "private_key": "-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n",
  "client_email": "sheets-writer@xxx.iam.gserviceaccount.com",
  "client_id": "...",
  "auth_uri": "https://accounts.google.com/o/oauth2/auth",
  "token_uri": "https://oauth2.googleapis.com/token"
}
"""
